services:
  app:
    image: myakad:latest
    container_name: myakad-app
    build:
      context: .
    ports:
      - "8081:8080"
    env_file:
      - .env
    environment:
      DB_CONNECTION: mysql
      DB_HOST: mysql
      DB_PORT: 3306
      DB_DATABASE: myakad
      DB_USERNAME: myakad
      DB_PASSWORD: myakad_secret
    volumes:
      - ./storage/app/public:/app/storage/app/public
      - ./storage/logs:/app/storage/logs
    depends_on:
      mysql:
        condition: service_healthy

  mysql:
    image: mysql:8.0
    container_name: myakad-mysql
    ports:
      - "3307:3306"
    environment:
      MYSQL_DATABASE: myakad
      MYSQL_USER: myakad
      MYSQL_PASSWORD: myakad_secret
      MYSQL_ROOT_PASSWORD: root_secret
    volumes:
      - ./docker/mysql/data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uroot", "-proot_secret"]
      interval: 5s
      timeout: 5s
      retries: 20
